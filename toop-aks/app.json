{
  "expo": {
    "name": "Toop Aks",
    "icon": "./assets/images/icon.png",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "extra": {
      "eas": {
        "projectId": "2d0d1155-f163-457a-b3d8-99578b99aff5"
      }
    },
    "android": {
      "package": "com.amirattar.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "owner": "amirattar",
    "plugins": [
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Toop Aks to access your photos to save invoices to your gallery.",
          "savePhotosPermission": "Allow saving photos to your gallery",
          "isAccessMediaLocation": true
        }
      ]
    ]
  }
}